  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: Teltmit
    sentences:
    - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, \u0434\u043E\u0431\u0440\u043E\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A."
    - "\u041E\u0442 \u043B\u0438\u0446\u0430 \u0432\u043B\u0430\u0434\u044B\u043A\u0438 \u044D\u0442\u043E\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \"\u0421\u043E\u043B\u043D\u0446\u0435\"."
    - "\u042F \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0435\u043D \u0437\u0430 \u043F\u0440\u043E\u0434\u0435\u043B\u0430\u043D\u043D\u0443\u044E \u043F\u043E\u043C\u043E\u0449\u044C \u043C\u043E\u0438\u043C \u0436\u0438\u0442\u0435\u043B\u044F\u043C."
    - "\u0422\u0435\u043F\u0435\u0440\u044C \u0436\u0438\u0437\u043D\u044C \u0441\u0442\u0430\u043D\u0435\u0442 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u0435\u0435."
    - "\u0417\u0430 \u044D\u0442\u043E \u044F \u043D\u0430\u0433\u0440\u0430\u0436\u0443 \u0442\u0435\u0431\u044F \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E\u0439 \u043D\u0430\u0433\u0440\u0430\u0434\u043E\u0439."
    - "\u0412\u043E\u0437\u043D\u0435\u0441\u0435\u043D\u0438\u0435\u043C!"
  dialogueManager: {fileID: 0}
