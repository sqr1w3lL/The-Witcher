--- !u!114 &7287718997042507313
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1682863513202351767}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22ccf07c5711acb4ba56d9f702bdcb87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: Kaldr
    sentences:
    - "\u0421\u0430\u043B\u0430\u043C \u0410\u043B\u0435\u0439\u043A\u0443\u043C, \u0434\u0440\u0443\u0436\u0438\u0449\u0435."
    - "\u042F CooKaldr, \u0432\u0435\u0440\u0445\u043E\u0432\u043D\u044B\u0439 \u043C\u0430\u0433."
    - "\u0417\u0430\u0449\u0438\u0449\u0430\u044E \u0434\u0430\u043D\u043D\u043E\u0435 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0435 \u0421\u043E\u043B\u043D\u0446\u0430."
    - "\u0418 \u0441\u043E\u0437\u0434\u0430\u044E \u043D\u043E\u0432\u044B\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F, \u0434\u043B\u044F \u0443\u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F \u0436\u0438\u0437\u043D\u044C \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u0449\u0438\u043D."
    - "\u0414\u043B\u044F \u043D\u043E\u0432\u043E\u0433\u043E \u0437\u0435\u043B\u044C\u044F \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438, \u043C\u043D\u0435 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0442\u0435\u0442 \u043F\u0430\u0440\u0443 \u0437\u0435\u043B\u0435\u043D\u0438."
    - "\u041C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0440\u0443\u0431\u0438\u0442\u044C 3 \u0448\u0442\u0443\u0447\u043A\u0438, \u044F \u0442\u0435\u043B\u0435\u043F\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0441\u0430\u043C \u0437\u0430\u0431\u0435\u0440\u0443."
  dialogueManager: {fileID: 0}
