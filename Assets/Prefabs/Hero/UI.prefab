  m_Script: {fileID: 11500000, guid: 31d243bbfc54fb44790a595291e8ba52, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestChecker
  dialogueManager: {fileID: 0}
  questManager: {fileID: 0}
  quest:
    name: "\u0412\u043E\u0441\u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435 \u0441\u0435\u043C\u044C\u0438"
    description: "\u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 \u043F\u0443\u0433\u043B\u0438\u0432\u043E\u0439 astrrr, \u043D\u0430\u0439\u0442\u0438 \u0435\u0451 \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0443\u044E \u0441\u0435\u0441\u0442\u0440\u0443, \u0447\u0442\u043E \u0437\u0430\u0431\u043B\u0443\u043A\u0430\u043B\u0430 \u043F\u0430\u0440\u0443 \u043D\u0435\u0434\u0435\u043B\u044C \u043D\u0430\u0437\u0430\u0434."
    task: "\u041D\u0430\u0439\u0442\u0438 \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0443\u044E \u0441\u0435\u0441\u0442\u0440\u0443: 0/1"
  activatorQuest: {fileID: 0}
  taskCheckerSO: {fileID: 0}
  questIsActive: 1
  questIsCompleted: 0
