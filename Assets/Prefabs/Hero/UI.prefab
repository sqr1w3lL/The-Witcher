  m_Script: {fileID: 11500000, guid: 22ccf07c5711acb4ba56d9f702bdcb87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: N1X
    sentences:
    - "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E, \u0434\u043E\u0431\u0440\u044B\u0439 \u043C\u043E\u043B\u043E\u0434\u0435\u0446."
    - "\u042F \u0431\u043E\u0433\u0430\u0442\u044B\u0440\u044C, N1X."
    - "\u0418\u0437 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u0428\u043C\u0430\u0443\u0437\u0435\u0440\u043E\u0432."
    - "\u041D\u0435\u0434\u0430\u0432\u043D\u043E \u043E\u0442 \u043C\u0435\u043D\u044F \u0441\u0431\u0435\u0436\u0430\u043B\u0430 \u043C\u043E\u044F \u0434\u043E\u043C\u0430\u0448\u043D\u044F \u0437\u0432\u0435\u0440\u0443\u0448\u043A\u0430."
    - "\u041A\u0430\u043F\u0438\u0431\u0430\u0440\u0430, \u0435\u0451 \u0437\u0432\u0430\u043B\u0438 \u0414\u0436\u0438\u043C\u043C\u0438."
    - "\u041F\u043E \u0437\u0430\u043A\u043E\u043D\u0430\u043C \u0441\u0435\u043C\u044C\u0438, \u0435\u0441\u043B\u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0443\u0431\u0435\u0433\u0430\u0435\u0442, \u0437\u043D\u0430\u0447\u0438\u0442 \u043E\u043D\u043E \u043D\u0435 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u043E \u0436\u0438\u0442\u044C."
    - "\u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E \u0442\u0430\u043A\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u0430.."
    - "\u0418\u0441\u043F\u043E\u043B\u043D\u0438 \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430 \u044D\u0442\u043E\u0442 \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440, \u0443 \u043C\u0435\u043D\u044F \u0440\u0443\u043A\u0438 \u043D\u0430 \u044D\u0442\u043E \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0443\u0442\u044C\u0441\u044F."
  dialogueManager: {fileID: 0}
