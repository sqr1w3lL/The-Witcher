  dialogueManager: {fileID: 0}
  questManager: {fileID: 0}
  quest:
    name: "\u0410\u043D\u0433\u0435\u043B \u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C"
    description: "\u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 Nuteko, \u043D\u0430\u0439\u0442\u0438 \u0442\u0440\u0438 \u0446\u0432\u0435\u0442\u043E\u0447\u043A\u0430 \u0434\u043B\u044F \u0441\u0432\u043E\u0435\u0439 \u0434\u0430\u043C\u044B, \u0447\u0442\u043E\u0431\u044B \u0441\u043F\u0430\u0441\u0442\u0438 \u0438\u0445 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F."
    task: "\u041D\u0430\u0439\u0442\u0438 \u0446\u0432\u0435\u0442\u043E\u0447\u043A\u0438: 0/3"
  activatorQuest: {fileID: 0}
