--- !u!114 &4596615817057897474
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 534822371215699250}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22ccf07c5711acb4ba56d9f702bdcb87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: Nuteko
    sentences:
    - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439 \u0434\u0440\u0443\u0433."
    - "\u0412\u0438\u0436\u0443 \u0442\u044B \u0442\u0443\u0442 \u0432\u043F\u0435\u0440\u0432\u044B\u0435. \u042F \u043F\u043E\u044D\u0442 \u044D\u0442\u043E\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0438."
    - "\u041F\u0438\u0448\u0443 \u0441\u0442\u0438\u0445\u0438, \u043F\u0440\u043E\u0437\u044B \u0438 \u043F\u043E\u0435\u0437\u0438\u0438."
    - "\u0421\u043E\u0432\u0441\u0435\u043C \u0441\u043A\u043E\u0440\u043E, \u0443 \u043D\u0430\u0441 \u0441 \u0412\u043E\u0437\u043B\u044E\u0431\u043B\u0435\u043D\u043D\u043E\u0439 \u0431\u0443\u0434\u0435\u0442 \u0433\u043E\u0434\u043E\u0432\u0449\u0438\u043D\u0430."
    - "\u0423\u0436\u0435 3 \u0433\u043E\u0434\u0430 \u0432\u043C\u0435\u0441\u0442\u0435, \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0437\u0434\u0440\u0430\u0432\u0438\u0442\u044C."
    - "\u041E\u0434\u043D\u0430\u043A\u043E \u044F \u0441\u043E\u0432\u0441\u0435\u043C \u0437\u0430\u0431\u044B\u043B \u043F\u0440\u043E \u044D\u0442\u043E \u0441\u043E\u0431\u044B\u0442\u0438\u0435."
    - "\u0421\u043B\u0443\u0448\u0430\u0439, \u0430 \u043D\u0435 \u043C\u043E\u0433 \u0431\u044B \u043F\u043E\u043C\u043E\u0447\u044C \u043C\u043D\u0435?"
    - "\u0415\u0441\u043B\u0438 \u043D\u0435 \u0441\u043B\u043E\u0436\u043D\u043E, \u043F\u0440\u0438\u043D\u0435\u0441\u0438 \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430 \u0442\u0440\u0438 \u0446\u0432\u0435\u0442\u043E\u0447\u043A\u0430."
  dialogueManager: {fileID: 0}
