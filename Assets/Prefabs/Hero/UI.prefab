--- !u!114 &4703091428948343482
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1122249281232422894}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22ccf07c5711acb4ba56d9f702bdcb87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: astrr
    sentences:
    - "\u041E\u0419! \u0422\u042B \u041C\u0415\u041D\u042F \u041D\u0410\u041F\u0423\u0413\u0410\u041B!"
    - "\u041D\u0435\u043B\u044C\u0437\u044F \u0436\u0435 \u0442\u0430\u043A \u043A \u043B\u044E\u0434\u044F\u043C \u043F\u043E\u0434\u043A\u0440\u0430\u0434\u044B\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E. \u0422-\u0422"
    - "\u0410 \u0435\u0441\u043B\u0438 \u0431\u044B \u044F \u0443\u043C\u0435\u0440\u043B\u0430?!"
    - "\u0412\u0441\u0451, \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u043C\u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D. :P"
    - "\u041C\u043E\u044F \u0441\u0435\u0441\u0442\u0440\u0430 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C \u0432 \u0434\u043E\u0440\u043E\u0433\u0443 \u043F\u0430\u0440\u0443 \u043D\u0435\u0434\u0435\u043B\u044C \u043D\u0430\u0437\u0430\u0434."
    - "\u041D\u043E \u0442\u0430\u043A \u0438 \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C."
    - "\u042F \u0435\u0449\u0451 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F, \u0441 \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u043D\u0435 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u044E\u0442."
    - "\u0410 \u0442\u044B \u0432\u0438\u0436\u0443, \u0441 \u043C\u0435\u0447\u043E\u043C \u0445\u043E\u0434\u0438\u0448\u044C. \u041F\u043E\u043C\u043E\u0436\u0435\u0448\u044C \u0435\u0451 \u043D\u0430\u0439\u0442\u0438? "
    - "\u041A\u0430\u043A \u0440\u0430\u0437 \u0434\u043E\u043B\u0436\u043E\u043A \u0432\u0435\u0440\u043D\u0451\u0448\u044C)"
  dialogueManager: {fileID: 0}
--- !u!114 &3611638125407913585
