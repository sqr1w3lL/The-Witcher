--- !u!114 &3648641220138751396
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2570651853640975444}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22ccf07c5711acb4ba56d9f702bdcb87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: Coviello
    sentences:
    - "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u0435\u0447\u043A\u043E, \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043C\u0441\u044F?"
    - "\u042F \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u0446\u0430. \u0418\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u044E \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E \u043D\u0430 \u043F\u043B\u0430\u043A\u0430\u0442\u0430\u0445."
    - "\u0422\u0435\u043C \u0441\u0430\u043C\u044B\u043C \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E \u043D\u0430 \u0441\u0432\u043E\u044E \u0436\u0438\u0437\u043D\u044C."
    - "\u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043C\u043E\u044F \u0440\u0430\u0431\u043E\u0442\u0430."
    - "\u041E\u0434\u043D\u0430\u043A\u043E, \u044F \u0431\u044B \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0442\u0435\u043B\u0430 \u043F\u0440\u043E\u0439\u0442\u0438 \u043A \u041E\u0437\u0435\u0440\u0443 \u041B\u044E\u0431\u0432\u0438, \u0447\u0442\u043E\u0431\u044B \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0439 \u0448\u0435\u0434\u0435\u0432\u0440."
    - "\u041D\u043E \u0435\u0433\u043E \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u0441\u043A\u0435\u043B\u0435\u0442. \u042F \u0441\u043B\u0430\u0431\u0430\u044F \u0434\u0435\u0432\u0443\u0448\u043A\u0430, \u0438 \u0431\u0435\u0437 \u043F\u043E\u043C\u043E\u0449\u0438 \u044F\u0432\u043D\u043E \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u043B\u044E\u0441\u044C."
    - "\u0421\u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043C\u043E\u0447\u044C?"
  dialogueManager: {fileID: 0}
