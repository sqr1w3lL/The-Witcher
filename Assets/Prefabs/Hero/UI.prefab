--- !u!114 &3292488014309393856
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1391726031581993659}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22ccf07c5711acb4ba56d9f702bdcb87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: dagar
    sentences:
    - "\u041E \u043F\u0440\u0438\u0432\u0435\u0442!"
    - "\u042F \u0442\u0435\u0431\u044F \u0440\u0430\u043D\u044C\u0448\u0435 \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u0432\u0438\u0434\u0435\u043B, \u043F\u0440\u0438\u0431\u044B\u043B \u0441 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u043A\u0440\u0430\u0451\u0432?"
    - "\u041F\u043E\u043D\u044F\u0442\u043D\u043E-\u043F\u043E\u043D\u044F\u0442\u043D\u043E, \u043D\u0435 \u043B\u0435\u0437\u0443 \u043D\u0435 \u0432 \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E)"
    - "\u041C\u043E\u0451 \u0445\u043E\u0431\u0431\u0438 - \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u043F\u0438\u0432\u043E. \u0414\u0430\u0436\u0435 \u0441\u0432\u043E\u044F \u043F\u0438\u0432\u043E\u0432\u0430\u0440\u043D\u044F \u0435\u0441\u0442\u044C)"
    - "\u0418\u0437-\u0437\u0430 \u043F\u043B\u043E\u0442\u043D\u043E\u0433\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0437\u0430\u043A\u0430\u0437\u043E\u0432, \u0437\u0430\u043F\u0430\u0441\u044B \u0443\u0445\u043E\u0434\u044F\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C \u044F \u0443\u0441\u043F\u0435\u0432\u0430\u044E \u0435\u0433\u043E \u043D\u0430\u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C."
    - "\u0415\u0441\u043B\u0438 \u043F\u043E\u043C\u043E\u0436\u0435\u0448\u044C \u043C\u043D\u0435 \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u043F\u0430\u0440\u0443 \u0433\u0440\u0438\u0431\u043E\u0447\u043A\u043E\u0432, \u0441\u0434\u0435\u043B\u0430\u044E \u0437\u0430 \u044D\u0442\u043E \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E\u0435 \u043F\u0438\u0432\u043E)"
  dialogueManager: {fileID: 0}
